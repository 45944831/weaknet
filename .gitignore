# ===== 构建中间产物 =====
android/build/
android/_cm/
android/_cm_check/
# _jw/ 只有 out/ 是编译产物；com/ 下是手写回归单测（拦过 PortIdx 越界、
# FlowMatch 漏核端口两个上线级缺陷），必须入库，不能当中间产物忽略掉
android/_jw/out/
android/_jw/out2/
android/_tmpcls/
android/_tmpdex/
_build*/
_build_gui/
_build_cli/
_build/
*.spec

# ===== 本地自测脚本与调试截图（开发期临时物，不入库）=====
# 例外：tests/ 下的是正式回归资产（跨版本复用的验收脚本），必须入库。
# 上游目录里的散装 _t_*.py 仍不入库 —— 那些是一次性探针。
_t_*.py
_t_*.cjs
_t_*.log
!tests/
!tests/**

# ===== 自备的 Android SDK（269MB，需自行下载，见 README）=====
android/sdk/
android/cmdline.zip

# ===== 签名文件（构建时自动生成，不入仓库）=====
*.keystore
*.jks
*.idsig
# 签名口令（build.sh 读取它来签名；口令入库等于公开签名私钥的访问方式）
android/weaknet.keystore.pass

# ===== 运行时产物 =====
*.log
weaknet.log
# 用户保存的自定义场景（运行时生成，随环境而异，不入仓库）
weaknet_presets.json
# 局域网用户名与本机标识（同上，随机器而异）
weaknet_settings.json
serve.bin
__pycache__/
*.pyc

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db

# ===== 布局预览截图（临时）=====
_shot_*.png
# 真机回归脚本的截图输出目录（跑测试时自动生成，随机器而异）
_shots/

# ===== PyInstaller 产物（EXE 本身入库，构建中间产物不入库）=====
build/
dist/
