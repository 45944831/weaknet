<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.weaknet.app"
    android:versionCode="130"
    android:versionName="1.1.20">

    <!-- 与 build.sh 的 aapt2 link 参数保持一致（24/33）；显式声明后
         脱离 build.sh 直接用 aapt2 也不会退化成隐式默认值。
         targetSdk 29 → 33（2026-11-26，为对齐分区存储 / 组件导出 / 通知权限三项新约束）：
           * 30+ 的分区存储：本项目只写 getExternalFilesDir，不受影响；
           * 31+ 的 android:exported 强制：四个组件都已显式声明；
           * 31+ 的 PendingIntent 可变性：已带 FLAG_IMMUTABLE；
           * 33+ 的通知权限：见 MainActivity.requestNotificationPermission()。 -->
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="33" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 13(API 33) 起前台服务通知也要用户授权；不请求则服务照跑，
         但通知栏看不到「正在模拟弱网」，用户会以为没生效。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 11(API 30) 起有「包可见性」限制：不加声明时 getInstalledApplications()
         只能看到自己，应用列表会是空的，用户就没法选择要接管哪个 App。
         QUERY_ALL_PACKAGES 放开全部查询；<queries> 是官方推荐的更精确写法（只看有启动入口的），
         两者都写是为了兼容不同版本的 aapt2/系统解析。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Android 11+ 包可见性：设置界面点版本号要用 ACTION_VIEW 打开 GitHub 下载页，
             不声明 VIEW/https 时部分 ROM 上 resolveActivity 会拿不到浏览器。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="WeakNet"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:resizeableActivity="true">

        <service
            android:name=".NetService"
            android:exported="false" />

        <service
            android:name=".VpnNetService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- 手机竖版（screenOrientation 声明 + 代码兜底双保险）。sw≥600dp 的
             平板/折叠屏内屏在 MainActivity.applyOrientationPolicy 运行时放开：
             Android 12L+ 对大屏的方向锁定会 letterbox（大屏质量红线），16+/17
             直接忽略锁定参数。configChanges 保证折叠/旋转/分屏不重建 Activity。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="WeakNet"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
